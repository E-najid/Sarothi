<?xml version="1.0" encoding="utf-8"?>
<!--
  Sarothi's core manifest. Every permission the capability layer needs is declared
  here so it is merged into the app, and each one has a plain-language explanation
  in PermissionGuard.PERMISSION_EXPLANATIONS that the UI shows next to the request.

  Runtime permissions are requested by the plugin that needs them, at the moment it
  needs them - never all at once on first launch.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- network: model downloads and the handful of public APIs Sarothi uses -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- services: downloads, screen capture, scheduled tasks -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- scheduling -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- vault on shared storage, for Android versions without the SAF-only path -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- communication plugins -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Lets Sarothi set an alarm in the system Clock app on the user's behalf. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- voice input, and the optional camera plugin -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- location for weather, nearby places and location reminders -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      Geofence reminders only mean something when the screen is off, which is why
      Sarothi asks for background location. The geofence plugin refuses to arm a
      reminder without it rather than watching in the foreground and silently
      missing every arrival that happens with the phone in a pocket.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- system plugins -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- biometric convenience unlock; the key still comes from the passphrase -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Which other apps Sarothi may see. Declaring intents rather than
      QUERY_ALL_PACKAGES keeps the visible-app list to what the plugins actually
      launch or look up.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>

        <!--
          Primary screen perception and action path. The class lives in :core so the
          fully-qualified name in PermissionGuard and in the settings deep link is
          stable regardless of the application id; the manifest merger puts this
          entry into the app.
        -->
        <service
            android:name="com.ngi.sarothi.core.screen.SarothiAccessibilityService"
            android:exported="true"
            android:label="@string/sarothi_accessibility_summary"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sarothi_accessibility_service" />
        </service>

        <!-- Holds the MediaProjection virtual display for the screenshot fallback. -->
        <service
            android:name="com.ngi.sarothi.core.screen.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Model downloads: long-running, must survive the UI being closed. -->
        <service
            android:name="com.ngi.sarothi.core.model.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Scheduled tasks, overdue catch-up and alarm re-arming. -->
        <service
            android:name="com.ngi.sarothi.core.schedule.ScheduleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs user-scheduled on-device agent tasks that can take several minutes; they must not be stopped part way through operating another app." />
        </service>

        <!-- Location watching for geofence reminders, armed only while one exists. -->
        <service
            android:name="com.ngi.sarothi.core.smart.GeofenceWatcherService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name="com.ngi.sarothi.core.schedule.ScheduleReceiver"
            android:exported="false" />

        <receiver
            android:name="com.ngi.sarothi.core.schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
