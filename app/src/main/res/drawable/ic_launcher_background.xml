<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed adaptive-icon background. Converted 1:1 from branding/logo.svg:
     linearGradient #bgGrad, objectBoundingBox (0,0)->(1,1) over the rounded rect,
     which for a full-bleed adaptive layer maps to the 108x108dp canvas corners. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF2B6CB0" />
                <item android:offset="1" android:color="#FF1A4971" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
