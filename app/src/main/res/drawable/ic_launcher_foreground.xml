<?xml version="1.0" encoding="utf-8"?>
<!-- Sarothi launcher foreground. Geometry converted from branding/logo.svg
     (viewBox 0 0 380 380). The motif spans 77..303 in SVG units, i.e. ~64dp of the
     108dp adaptive canvas, which keeps it inside the 72dp launcher safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="380"
    android:viewportHeight="380">

    <!-- circle cx=190 cy=190 r=108, stroke #eaf3fb, stroke-width 10, no fill -->
    <path
        android:pathData="M82,190 A108,108 0 1,0 298,190 A108,108 0 1,0 82,190 Z"
        android:strokeColor="#EAF3FB"
        android:strokeWidth="10" />

    <!-- circle cx=190 cy=190 r=20, fill #eaf3fb -->
    <path
        android:pathData="M170,190 A20,20 0 1,0 210,190 A20,20 0 1,0 170,190 Z"
        android:fillColor="#EAF3FB" />

    <!-- four cardinal ticks, stroke #eaf3fb, stroke-width 10, round caps -->
    <path
        android:pathData="M190,82 L190,128 M298,190 L252,190 M190,298 L190,252 M82,190 L128,190"
        android:strokeColor="#EAF3FB"
        android:strokeWidth="10"
        android:strokeLineCap="round" />

    <!-- four accent dots r=9, fill #7fd4ff -->
    <path
        android:pathData="M181,102 A9,9 0 1,0 199,102 A9,9 0 1,0 181,102 Z
                          M269,190 A9,9 0 1,0 287,190 A9,9 0 1,0 269,190 Z
                          M181,278 A9,9 0 1,0 199,278 A9,9 0 1,0 181,278 Z
                          M93,190 A9,9 0 1,0 111,190 A9,9 0 1,0 93,190 Z"
        android:fillColor="#7FD4FF" />
</vector>
